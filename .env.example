# LDraw 3D Web Viewer - Environment Configuration
# Copy this file to .env.production.local for production builds

# Parts API URL
# -------------
# The LDraw parts library (478MB) is not bundled with the app.
# You must host the parts separately and configure the URL here.
#
# Development (default): Uses Vite middleware at /api/parts
# Production: Set to your parts server URL

# Example configurations:
# VITE_LDRAW_API_URL=https://parts-api.yourdomain.com
# VITE_LDRAW_API_URL=https://your-cdn.com/ldraw
# VITE_LDRAW_API_URL=/api/parts  (if same server serves parts)

# If not set, defaults to /api/parts (works in development only)
